-- Obfuscation Logic (Byte-level string encoding wrapper)
ObfuscateBtn.MouseButton1Click:Connect(function()
    local source = InputBox.Text
    if source == "" then
        OutputBox.Text = "-- Error: Input source is empty."
        return
    end

    local bytes = {}
    for i = 1, #source do
        table.insert(bytes, string.byte(source, i))
    end

    local encodedBytes = table.concat(bytes, ",")
    
    local wrapped = string.format([[
-- [CAT.JAILBREAK] Obfuscated via Solara Native Suite
local _b = {%s}
local _s = {}
for _, _v in ipairs(_b) do
    table.insert(_s, string.char(_v))
end
local _code = table.concat(_s)
return loadstring(_code)()
]], encodedBytes)

    OutputBox.Text = wrapped
end)

